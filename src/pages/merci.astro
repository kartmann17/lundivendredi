---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/astro/Nav.astro';
import Footer from '../components/astro/Footer.astro';
---

<BaseLayout
  title="Demande reçue · Merci | lundivendredi"
  description="Votre demande de réservation est bien arrivée. Réponse sous 4 h ouvrées."
  noindex
>
  <Nav />

  <main id="contenu" class="relative school-margin overflow-hidden py-24 md:py-40">
    <div aria-hidden="true" class="absolute -right-[6vw] top-[2vw] pointer-events-none ghost-num text-[40vw] md:text-[28vw] leading-none">✓</div>

    <div class="max-w-[1320px] mx-auto px-6 md:px-24 relative">
      <div class="flex items-center gap-3 mb-6">
        <span class="mono text-[11px] uppercase tracking-[0.22em] text-cream/55">№ confirmation</span>
        <span class="h-px w-16 bg-cream/20"></span>
        <span class="mono text-[11px] uppercase tracking-[0.22em] text-punch">demande reçue</span>
      </div>

      <h1 class="display text-[12vw] md:text-[7rem] leading-[0.9]">
        C'est <span class="display-italic">dans la boîte</span>.
      </h1>

      <p class="mt-10 display text-2xl md:text-3xl leading-[1.25] max-w-[42ch]" style="font-variation-settings: 'opsz' 60, 'wght' 360;">
        Ta demande est bien arrivée. Je la lis dans les heures qui viennent et je te recontacte
        <span class="marker">sous 4 h ouvrées</span> pour caler la visio de validation.
      </p>

      <div class="mt-16 grid grid-cols-12 gap-8 md:gap-12">
        <div class="col-span-12 md:col-span-7">
          <div class="mono text-[11px] uppercase tracking-[0.22em] text-cream/55 mb-4">↳ ce qui se passe maintenant</div>
          <ol class="space-y-5 text-cream/80 leading-relaxed">
            <li class="flex gap-4 border-b border-rule pb-4">
              <span class="text-punch mono">01.</span>
              <span>Vérifie que <strong>kreyatik@gmail.com</strong> n'atterrit pas dans tes spams. L'accusé arrive dans la minute.</span>
            </li>
            <li class="flex gap-4 border-b border-rule pb-4">
              <span class="text-punch mono">02.</span>
              <span>Prépare tes textes (présentation, services, contact). Pas besoin que ce soit parfait, on cadre lundi matin.</span>
            </li>
            <li class="flex gap-4 border-b border-rule pb-4">
              <span class="text-punch mono">03.</span>
              <span>Rassemble tes visuels — logo, photos d'activité, sites qui te plaisent.</span>
            </li>
            <li class="flex gap-4">
              <span class="text-punch mono">04.</span>
              <span>Si urgent, écris-moi ou appelle directement, je décroche.</span>
            </li>
          </ol>
        </div>

        <aside class="col-span-12 md:col-span-4 md:col-start-9">
          <div class="border border-rule p-8 relative">
            <div class="hand absolute -top-3 -right-3 text-2xl text-margin rotate-[-4deg]">à très vite&nbsp;!</div>
            <div class="mono text-[11px] uppercase tracking-[0.22em] text-cream/55 mb-3">contact direct</div>
            <a href="mailto:kreyatik@gmail.com" class="display text-2xl link-anim block mb-2">kreyatik@gmail.com</a>
            <a href="tel:+33695800663" class="mono text-sm text-cream/65 link-anim">06 95 80 06 63</a>
          </div>
        </aside>
      </div>

      <a href="/" class="mt-16 inline-flex items-center gap-3 mono text-[12px] uppercase tracking-[0.18em] text-cream link-anim">
        ← Retour à l'accueil
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
