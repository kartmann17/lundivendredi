---
import { FAQ as FAQ_DATA } from '../../data/faq';
---

<section
  id="faq"
  class="relative border-t border-rule py-24 md:py-36 overflow-hidden"
  aria-labelledby="faq-title"
>
  <div class="max-w-[1320px] mx-auto px-6 md:px-24">
    <div class="grid grid-cols-12 gap-6 mb-12 md:mb-20 items-end">
      <div class="col-span-12 md:col-span-3 mono text-[11px] uppercase tracking-[0.22em] text-cream/55">
        № 07 — questions
      </div>
      <h2 id="faq-title" class="col-span-12 md:col-span-9 display text-[10vw] md:text-7xl leading-[0.95]">
        Tout ce qu'on me <span class="display-italic">redemande</span>.
      </h2>
    </div>

    <div class="grid grid-cols-12 gap-10">
      <div class="col-span-12 md:col-span-9 md:col-start-2">
        {
          FAQ_DATA.map((item) => (
            <details class="border-b border-rule py-2">
              <summary class="flex items-baseline justify-between gap-6 py-5 group">
                <span class="display text-2xl md:text-3xl leading-[1.2] flex-1" set:html={item.question} />
                <span class="plus mono text-2xl text-punch shrink-0" aria-hidden="true">+</span>
              </summary>
              <div class="faq-a pb-6 max-w-[60ch] text-cream/75 leading-relaxed">{item.answer}</div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
