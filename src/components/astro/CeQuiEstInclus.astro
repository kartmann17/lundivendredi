---
const items = [
  {
    title: 'Design <span class="display-italic">sur-mesure</span>',
    body: 'Pas de template. Maquettes uniques validées le mardi soir, basées sur ton univers, ton métier, ta clientèle.',
  },
  {
    title: 'Site <span class="display-italic">responsive</span> impec',
    body: 'Mobile, tablette, desktop. 95+ sur Lighthouse perf & accessibilité, ou je recommence.',
  },
  {
    title: 'Hébergement <span class="display-italic">1 an offert</span>',
    body: "Hébergeur français (OVH ou Infomaniak, à toi de voir). Renouvellement : ~6€/mois après. Pas d'engagement.",
  },
  {
    title: 'Nom de domaine <span class="display-italic">1 an</span>',
    body: '.fr ou .com, à ton nom, sans hold-up. Tu en es propriétaire dès le 1er jour.',
  },
  {
    title: 'SEO <span class="display-italic">de base</span> solide',
    body: 'Balises propres, sitemap, schema.org, fiche Google Business optimisée. Pas de promesse magique de 1ère page.',
  },
  {
    title: 'Formulaire <span class="display-italic">qui marche</span>',
    body: 'Anti-spam, RGPD, mails reçus directement, accusé automatique. Testé devant toi.',
  },
  {
    title: 'Formation <span class="display-italic">30 minutes</span>',
    body: 'Visio vendredi soir : on parcourt ensemble comment modifier les textes, ajouter une photo, un article. Enregistrée pour toi.',
  },
  {
    title: 'Mentions légales <span class="display-italic">conformes</span>',
    body: 'Mentions, politique de confidentialité, bandeau cookies RGPD. Modèle audité par juriste, adapté à ton activité.',
  },
];
---

<section
  id="inclus"
  class="relative border-t border-rule py-24 md:py-36 overflow-hidden"
  aria-labelledby="inclus-title"
>
  <div class="max-w-[1320px] mx-auto px-6 md:px-24">
    <div class="grid grid-cols-12 gap-6 items-end mb-12 md:mb-20">
      <div class="col-span-12 md:col-span-6">
        <div class="mono text-[11px] uppercase tracking-[0.22em] text-cream/55 mb-4">№ 03 — le contenu</div>
        <h2 id="inclus-title" class="display text-[10vw] md:text-7xl leading-[0.95]">
          Tout ce qu'on <span class="display-italic">empile</span> dans le carton.
        </h2>
      </div>
      <div class="col-span-12 md:col-span-5 md:col-start-8">
        <p class="text-cream/70 leading-relaxed text-lg">
          Pas de "à partir de", pas d'options en supplément.
          <span class="marker">8 livrables</span>, le même prix pour tout le monde.
        </p>
      </div>
    </div>

    <ol class="grid grid-cols-12 gap-x-6 gap-y-4 md:gap-y-2">
      {
        items.map((item, i) => (
          <li class="col-span-12 group relative">
            <div class="grid grid-cols-12 items-baseline border-b border-rule py-6 md:py-7">
              <div class="col-span-2 md:col-span-1 mono text-[12px] uppercase tracking-[0.22em] text-cream/40">
                {String(i + 1).padStart(2, '0')}
              </div>
              <h3
                class="col-span-10 md:col-span-5 display text-2xl md:text-4xl leading-[1.05]"
                set:html={item.title}
              />
              <p class="col-span-12 md:col-span-6 text-cream/65 mt-2 md:mt-0 text-[15px] md:text-base leading-relaxed">
                {item.body}
              </p>
            </div>
          </li>
        ))
      }
    </ol>

    <!-- Sceau remboursé -->
    <div class="mt-16 grid grid-cols-12 gap-6 items-center">
      <div class="col-span-12 md:col-span-7">
        <p class="display text-3xl md:text-5xl leading-[1.05]">
          <span class="display-italic">Un point manque&nbsp;?</span><br />
          On l'ajoute. <span class="marker-yellow">C'est compris.</span>
        </p>
      </div>
      <div class="col-span-12 md:col-span-5 flex md:justify-end">
        <div class="seal">
          <div>
            <div class="display text-base mb-1" style="letter-spacing: 0.04em;">Garanti</div>
            <div class="display-italic text-lg">remboursé</div>
            <div class="text-[9px] mt-1 opacity-70">si pas livré ven. 17h</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
