---
import { SITE } from '../../lib/seo';
import { TOTAL_DISPO } from '../../data/creneaux';
const year = new Date().getFullYear();
const placesText = TOTAL_DISPO === 0
  ? 'complet ce trimestre'
  : `${TOTAL_DISPO} place${TOTAL_DISPO > 1 ? 's' : ''} restante${TOTAL_DISPO > 1 ? 's' : ''}`;
---

<footer class="relative border-t border-rule pt-20 pb-10 overflow-hidden">
  <div class="max-w-[1320px] mx-auto px-6 md:px-24 relative">
    <!-- Big tagline -->
    <div class="grid grid-cols-12 gap-6 mb-20">
      <div class="col-span-12">
        <h2 class="display text-[14vw] md:text-[10rem] leading-[0.85]">
          On se voit<br />
          <span class="display-italic text-cream/40">lundi&nbsp;?</span>
        </h2>
      </div>
    </div>

    <div class="grid grid-cols-12 gap-6 border-t border-rule pt-10">
      <div class="col-span-12 md:col-span-4">
        <div class="display text-2xl">
          lundi<span class="display-italic text-punch">vendredi</span>
        </div>
        <p class="mono text-[11px] uppercase tracking-[0.18em] text-cream/55 mt-3 leading-relaxed">
          {SITE.legalName}<br />
          Lionel Blanchet · Designer & développeur freelance.<br />
          Rochefort (17), Charente-Maritime.<br />
          Toute la France, en visio.
        </p>
      </div>
      <div class="col-span-6 md:col-span-2">
        <div class="mono text-[10px] uppercase tracking-[0.22em] text-cream/40 mb-3">Pages</div>
        <ul class="space-y-1">
          <li><a class="link-anim text-cream/85" href="/#offre">L'offre</a></li>
          <li><a class="link-anim text-cream/85" href="/#inclus">Inclus</a></li>
          <li><a class="link-anim text-cream/85" href="/#semaine">La semaine</a></li>
          <li><a class="link-anim text-cream/85" href="/#faq">FAQ</a></li>
        </ul>
      </div>
      <div class="col-span-6 md:col-span-2">
        <div class="mono text-[10px] uppercase tracking-[0.22em] text-cream/40 mb-3">Légal</div>
        <ul class="space-y-1">
          <li><a class="link-anim text-cream/85" href="/mentions-legales">Mentions légales</a></li>
          <li><a class="link-anim text-cream/85" href="/confidentialite">Confidentialité</a></li>
        </ul>
      </div>
      <div class="col-span-12 md:col-span-4">
        <div class="mono text-[10px] uppercase tracking-[0.22em] text-cream/40 mb-3">Contact direct</div>
        <a class="display text-3xl link-anim" href={`mailto:${SITE.contact.emailDisplay}`}>
          {SITE.contact.emailDisplay}
        </a>
        <div class="mono text-[12px] mt-2 text-cream/55">
          <a href={`tel:${SITE.contact.phone}`} class="link-anim">{SITE.contact.phoneDisplay}</a> · lun → ven · 9h-18h
        </div>
      </div>
    </div>

    <div class="mt-16 flex flex-col md:flex-row md:items-baseline justify-between gap-4 mono text-[11px] uppercase tracking-[0.18em] text-cream/40">
      <div>© {year} {SITE.legalName} · TVA non applicable, art. 293B du CGI.</div>
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-punch animate-pulse" aria-hidden="true"></span>
        <span>Cr&eacute;neaux ouverts &middot; {placesText}</span>
      </div>
    </div>
  </div>
</footer>
