---
const jours = [
  {
    n: '01',
    nom: 'Lundi',
    date: 'J 01',
    items: [
      'Kick-off visio 30 min',
      'Brief, ton, références',
      'Photos + textes reçus',
      'Architecture posée',
    ],
    annotation: 'on démarre !',
  },
  {
    n: '02',
    nom: 'Mardi',
    date: 'J 02',
    items: [
      'Maquettes desktop',
      'Maquettes mobile',
      'Validation 18 h',
      { struck: 'Couleur jaune', after: ' ✓ vert' },
    ],
  },
  {
    n: '03',
    nom: 'Mercredi',
    date: 'J 03',
    items: [
      'Intégration HTML/CSS',
      'Pages connectées',
      'Animations propres',
      'Responsive câblé',
    ],
  },
  {
    n: '04',
    nom: 'Jeudi',
    date: 'J 04',
    items: [
      'SEO + perfs',
      'Formulaire branché',
      'Tests devices',
      'Relecture textes',
    ],
    postit: 'ne pas oublier :\nfavicon !!',
  },
  {
    n: '05',
    nom: 'Vendredi',
    date: 'J 05',
    items: [
      'Mise en ligne — 14 h',
      'Formation visio — 16 h',
      'Recette ensemble',
      { strong: 'Site livré · 17 h' },
    ],
    stamp: 'LIVRÉ ✓',
    isFriday: true,
  },
];
---

<section
  id="semaine"
  class="relative border-t border-rule py-24 md:py-36 overflow-hidden"
  aria-labelledby="timeline-title"
>
  <!-- Filigrane « la semaine » -->
  <div
    aria-hidden="true"
    class="absolute -left-[2vw] -top-[1vw] pointer-events-none ghost-num text-[18vw] md:text-[14vw] font-medium leading-none"
  >
    la&nbsp;semaine
  </div>

  <div class="max-w-[1320px] mx-auto px-6 md:px-24 relative">
    <div class="grid grid-cols-12 gap-6 mb-12 md:mb-20 items-end">
      <div class="col-span-12 md:col-span-3 mono text-[11px] uppercase tracking-[0.22em] text-cream/55">
        № 04 — le planning
      </div>
      <h2 id="timeline-title" class="col-span-12 md:col-span-9 display text-[10vw] md:text-7xl leading-[0.95]">
        5 pages de cahier.<br />
        <span class="display-italic">Lundi → vendredi.</span>
      </h2>
    </div>

    <!-- Compteur jours animé -->
    <div
      id="weekStrip"
      class="flex flex-wrap items-baseline gap-3 md:gap-6 mb-16 md:mb-20 mono text-[12px] md:text-base uppercase tracking-[0.22em]"
      aria-label="Du lundi au vendredi"
    >
      <span class="day" data-day="1">Lundi</span><span class="text-cream/20">·</span>
      <span class="day" data-day="2">Mardi</span><span class="text-cream/20">·</span>
      <span class="day" data-day="3">Mercredi</span><span class="text-cream/20">·</span>
      <span class="day" data-day="4">Jeudi</span><span class="text-cream/20">·</span>
      <span class="day final" data-day="5"><span class="marker">Vendredi</span></span>
    </div>

    <!-- Pages cahier en escalier -->
    <div class="pages-row grid grid-cols-1 md:grid-cols-5 gap-6 md:gap-5 items-start">
      {
        jours.map((j) => (
          <article class="page-card lined p-7 pl-20 min-h-[360px] reveal relative">
            <div class="holes">
              <span /><span /><span /><span />
            </div>
            <div class="red-margin" />
            <header class="flex items-baseline justify-between mb-3">
              <div>
                <div class="mono text-[10px] uppercase tracking-[0.22em] text-mute">Jour {j.n}</div>
                <h3 class="display text-3xl leading-[1] mt-1">
                  {j.isFriday ? <span class="pen-circle">{j.nom}</span> : j.nom}
                </h3>
              </div>
              <div class="mono text-[10px] text-mute">{j.date}</div>
            </header>
            <ul class="text-[15px] text-ink/85 leading-[2rem] space-y-0">
              {j.items.map((item) => {
                if (typeof item === 'string') return <li>{item}</li>;
                if ('struck' in item)
                  return (
                    <li>
                      <span style="text-decoration: line-through; opacity: .5">{item.struck}</span>
                      {item.after}
                    </li>
                  );
                return (
                  <li>
                    <strong>{item.strong}</strong>
                  </li>
                );
              })}
            </ul>
            {j.annotation && (
              <div class="hand text-margin text-2xl absolute right-4 bottom-3 rotate-[-3deg]">
                {j.annotation}
              </div>
            )}
            {j.postit && (
              <div class="postit absolute -right-3 -top-4 w-32 h-24 px-3 py-2 text-[18px] leading-[1.1]">
                {j.postit.split('\n').map((line, i) => (
                  <Fragment>
                    {i > 0 && <br />}
                    {line}
                  </Fragment>
                ))}
              </div>
            )}
            {j.stamp && (
              <div class="absolute right-3 bottom-3" style="transform: rotate(-14deg);">
                <div style="border: 2.5px solid #D4541C; color:#D4541C; padding:6px 10px; font-family: var(--font-mono); font-size:10px; letter-spacing: 0.18em; font-weight:500;">
                  {j.stamp}
                </div>
              </div>
            )}
          </article>
        ))
      }
    </div>

    <!-- Légende -->
    <div class="mt-16 grid grid-cols-12 gap-6 items-start">
      <div class="col-span-12 md:col-span-1 mono text-[11px] uppercase tracking-[0.22em] text-cream/40">↳ note</div>
      <p class="col-span-12 md:col-span-7 text-cream/65 leading-relaxed text-[15px]">
        Ce planning est <em>réel</em>. C'est exactement comment se passent toutes les semaines depuis 2023.
        Aucun "imprévu", aucun "petit dépassement". Si tu réserves la semaine 19, tu reçois ton site le
        vendredi à 17 h, montre en main.
      </p>
    </div>
  </div>
</section>
