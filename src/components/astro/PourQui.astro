---
---

<section
  id="offre"
  class="relative school-margin border-t border-rule py-24 md:py-36 overflow-hidden"
  aria-labelledby="pour-qui-title"
>
  <div class="max-w-[1320px] mx-auto px-6 md:px-24 relative">
    <div class="grid grid-cols-12 gap-6 mb-16 md:mb-24 items-end">
      <div class="col-span-12 md:col-span-2 mono text-[11px] uppercase tracking-[0.22em] text-ink/55">№ 02</div>
      <h2 id="pour-qui-title" class="col-span-12 md:col-span-10 display text-[10vw] md:text-7xl leading-[0.95] reveal">
        Trois profils qui n'ont <span class="display-italic text-ink/70">pas 3 mois</span> à perdre.
      </h2>
    </div>

    <div class="grid grid-cols-12 gap-6 md:gap-10">
      <!-- Profil 1 — taille XL -->
      <article class="col-span-12 md:col-span-7 reveal relative">
        <div class="border border-rule p-8 md:p-12 relative">
          <div class="flex items-center justify-between mb-6">
            <span class="mono text-[11px] uppercase tracking-[0.22em] text-ink/55">profil A</span>
            <span class="mono text-[11px] uppercase tracking-[0.22em] text-ink/30">⌗ 01/03</span>
          </div>
          <h3 class="display text-5xl md:text-6xl leading-[0.95]">
            L'artisan<br />
            <span class="display-italic">qui ne veut</span><br />
            pas perdre<br />
            <span class="display-italic">son samedi</span> à<br />
            chercher un dev.
          </h3>
          <p class="mt-8 text-ink/70 max-w-[40ch] leading-relaxed">
            Plombier, ébéniste, paysagiste, boulanger. Tu veux un site qui inspire confiance, qui montre tes
            réalisations, et que les gens trouvent sur Google quand ils cherchent un pro près d'eux.
          </p>
          <div class="hand absolute -right-4 -top-6 text-2xl text-margin rotate-[-6deg]">↘ toi&nbsp;?</div>
        </div>
      </article>

      <!-- Profils 2 + 3 stack -->
      <div class="col-span-12 md:col-span-5 grid grid-cols-1 gap-6 md:gap-10 md:mt-20">
        <article class="reveal border border-rule p-8 relative">
          <div class="flex items-center justify-between mb-4">
            <span class="mono text-[11px] uppercase tracking-[0.22em] text-ink/55">profil B</span>
            <span class="mono text-[11px] uppercase tracking-[0.22em] text-ink/30">⌗ 02/03</span>
          </div>
          <h3 class="display text-3xl md:text-4xl leading-[1]">
            L'<span class="display-italic">indé</span> en lancement
          </h3>
          <p class="mt-4 text-ink/70 leading-relaxed text-[15px]">
            Coach, consultant, thérapeute, photographe. Tu lances ton activité demain, il te faut un site
            crédible <em>maintenant</em>, pas dans 3 mois.
          </p>
        </article>

        <article class="reveal border border-rule p-8 relative">
          <div class="flex items-center justify-between mb-4">
            <span class="mono text-[11px] uppercase tracking-[0.22em] text-ink/55">profil C</span>
            <span class="mono text-[11px] uppercase tracking-[0.22em] text-ink/30">⌗ 03/03</span>
          </div>
          <h3 class="display text-3xl md:text-4xl leading-[1]">
            La <span class="display-italic">TPE</span> qui a un site moche
          </h3>
          <p class="mt-4 text-ink/70 leading-relaxed text-[15px]">
            Ton site date de 2014, il rame, il est moche, il ne convertit rien. On le remplace cette semaine.
            Tu reprends le travail lundi prochain.
          </p>
        </article>
      </div>
    </div>

    <!-- Disqualification -->
    <div class="mt-20 md:mt-28 grid grid-cols-12 gap-6 items-start reveal">
      <div class="col-span-12 md:col-span-5 mono text-[11px] uppercase tracking-[0.22em] text-ink/55">↳ et c'est pas pour</div>
      <p
        class="col-span-12 md:col-span-7 display text-2xl md:text-3xl leading-[1.2] text-ink/85"
        style="font-variation-settings: 'opsz' 60, 'wght' 380;"
      >
        Les <span class="display-italic">e-commerces complexes</span>, les SaaS B2B, les apps métier, les sites à
        200 pages. Pour ça : <a class="link-anim text-ink" href="#reserver">parlons devis sur mesure</a>.
      </p>
    </div>
  </div>
</section>
